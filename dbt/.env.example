# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO DBT & SNOWFLAKE
# ------------------------------------------------------------------------------
# Destino do profile (ex: dev, prod, qa)
DBT_TARGET=dev

# Identificador da conta Snowflake (ex: xy12345.us-east-1)
DBT_SNOWFLAKE_ACCOUNT=your_snowflake_account_id
DBT_SNOWFLAKE_USER=your_username
DBT_SNOWFLAKE_PASSWORD=your_password_here
DBT_SNOWFLAKE_ROLE=your_role_name
DBT_SNOWFLAKE_DATABASE=your_database_name
DBT_SNOWFLAKE_WAREHOUSE=your_warehouse_name
DBT_SNOWFLAKE_SCHEMA=your_schema_name

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DA AWS & ARMAZENAMENTO S3
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# URL do endpoint S3 (relevante se usar MinIO ou LocalStack para fins locais)
AWS_S3_ENDPOINT=https://amazonaws.com
AWS_S3_USE_SSL=true

# Opcional: Necessário apenas se você utiliza autenticação MFA ou credenciais temporárias
AWS_SESSION_TOKEN=your_session_token_if_applicable
